-- Tabla HUESPEDES
CREATE TABLE huespedes (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR2(100),
    apellido VARCHAR2(100),
    email VARCHAR2(150),
    telefono VARCHAR2(20),
    tipoDocumento VARCHAR2(50),
    nacionalidad VARCHAR2(100)
);

-- Tabla HABITACIONES
CREATE TABLE habitaciones (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    numero NUMBER,
    tipo VARCHAR2(50),
    descripcion VARCHAR2(500),
    precio NUMBER(10,2),
    capacidad NUMBER,
    estado VARCHAR2(20)
);

-- Tabla RESERVAS
CREATE TABLE reservas (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    huesped_id NUMBER,
    habitacion_id NUMBER,
    fecha_entrada DATE,
    fecha_salida DATE,
    noches NUMBER,
    total NUMBER(10,2),
    estado VARCHAR2(20)
);